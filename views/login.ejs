<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Labeling - Login</title>
        <%- include('./partials/head/meta'); %>
        <%- include('./partials/head/link'); %>
        <%- include('./partials/head/noscript'); %>
    </head>
    <body class="min-vh-100 mw-100 d-flex flex-column justify-content-between">
        <%- include('./partials/header'); %>
        <main>
            <h1 class="text-center mb-3">Login</h1>
            <div class="d-flex flex-column align-items-center">
                <% if (authenticationFailed || csrfFailed) { %>
                    <p id="login-error" class="alert alert-danger" role="alert">
                        <%= csrfFailed ? "Your login form expired. Please try again." : "Invalid username or password." %>
                    </p>
                <% } %>
                <form id="login-form"
                      action="/login"
                      method="post"
                      aria-describedby="<%= authenticationFailed || csrfFailed ? "login-error" : "" %>"
                      autocomplete="on"
                      class="row g-3 mx-0 align-items-center"
                >
                    <div class="col-12">
                        <label for="username">Username</label>
                        <div class="input-group">
                            <div class="input-group-text">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <input id="username"
                                   name="username"
                                   type="text"
                                   class="form-control"
                                   autocomplete="username"
                                   autofocus
                                   required
                            >
                        </div>
                    </div>
                    <div class="col-12">
                        <label for="password">Password</label>
                        <input id="password" name="password" type="password" class="form-control" autocomplete="current-password" required>
                    </div>
                    <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
                    <div class="col-12">
                        <div class="d-grid d-lg-block">
                            <button type="submit" class="btn btn-dark">Start!</button>
                        </div>
                    </div>
                </form>
            </div>
        </main>
        <%- include('./partials/footer'); %>
        <%- include('./partials/scripts/bootstrap'); %>
    </body>
</html>

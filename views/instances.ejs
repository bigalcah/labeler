<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Labeler - PR cards</title>
        <%- include('./partials/head/meta'); %>
        <%- include('./partials/head/link'); %>
        <%- include('./partials/head/noscript'); %>
    </head>
    <body class="min-vh-100 mw-100 d-flex flex-column justify-content-between">
        <%- include('./partials/header'); %>
        <main>
            <div class="container py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                    <div>
                        <span class="pr-section-eyebrow">Study sample</span>
                        <h1 class="h2 mb-1">PR cards</h1>
                        <p class="text-muted mb-0"><%= pagination.items %> cards in this view</p>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <% if (participant) { %>
                            <span class="badge rounded-pill text-bg-light border">
                                <i class="bi bi-person me-1" aria-hidden="true"></i><%= participant.name %>
                            </span>
                            <span class="badge rounded-pill text-bg-primary"><%= progress.completed %>/<%= progress.total %> completed</span>
                        <% } else { %>
                            <span class="badge rounded-pill text-bg-warning">Select a participant to see personal status</span>
                        <% } %>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mb-4">
                    <% [ [ "all", "All cards" ], [ "pending", "Pending" ], [ "classified", "Classified" ], [ "discarded", "Discarded" ] ].forEach(([ value, label ]) => { %>
                        <a class="btn btn-sm <%= status === value ? "btn-dark" : "btn-outline-secondary" %>"
                           href="/instances?status=<%= value %><%= participant ? `&participant=${encodeURIComponent(participant.name)}` : "" %>">
                            <%= label %>
                        </a>
                    <% }); %>
                    <% if (!participant) { %>
                        <a class="btn btn-sm btn-outline-primary" href="/login">Choose participant</a>
                    <% } %>
                </div>

                <div class="pr-card-list">
                    <% if (!cards.length) { %>
                        <div class="pr-empty-state">
                            <i class="bi bi-inbox" aria-hidden="true"></i>
                            <span>No PR cards match this filter.</span>
                        </div>
                    <% } %>
                    <% cards.forEach(card => { %>
                        <a class="pr-list-item" href="/<%= participant ? encodeURIComponent(participant.name) : "" %>/queue/<%= card.id %>">
                            <div class="pr-list-main">
                                <div class="pr-card-kicker mb-1">
                                    <span><%= card.repository || "Repository unavailable" %> #<%= card.pr_number || "?" %></span>
                                </div>
                                <h2 class="h5 mb-2"><%= card.title %></h2>
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge rounded-pill <%= card.merged ? "pr-status-merged" : card.state === "closed" ? "pr-status-closed" : "pr-status-open" %>"><%= card.merged ? "MERGED" : String(card.state || "UNKNOWN").toUpperCase() %></span>
                                    <% if (card.language) { %><span class="badge rounded-pill pr-language-badge"><%= card.language %></span><% } %>
                                </div>
                            </div>
                            <div class="pr-list-status text-md-end">
                                 <span class="badge rounded-pill <%= card.status === "CLASSIFIED" ? "text-bg-success" : card.status === "PENDING" ? "text-bg-warning" : card.status === "DISCARDED" ? "text-bg-secondary" : "text-bg-light border" %>"><%= card.status %></span>
                                 <% if (card.own_category) { %><small class="d-block text-muted mt-2"><%= card.own_category %></small><% } %>
                                 <% if (card.discard_reason) { %><small class="d-block text-muted mt-2"><%= card.discard_reason %></small><% } %>
                            </div>
                        </a>
                    <% }); %>
                </div>

                <% if (pagination.pages > 1) { %>
                    <nav class="d-flex justify-content-center gap-2 mt-4" aria-label="PR card pagination">
                        <% const base = `/instances?limit=${pagination.limit}&status=${status}${participant ? `&participant=${encodeURIComponent(participant.name)}` : ""}`; %>
                        <% if (pagination.current > 1) { %><a class="btn btn-outline-secondary" href="<%= base %>&page=<%= pagination.current - 1 %>">Previous</a><% } %>
                        <span class="btn btn-light disabled">Page <%= pagination.current %> / <%= pagination.pages %></span>
                        <% if (pagination.current < pagination.pages) { %><a class="btn btn-outline-secondary" href="<%= base %>&page=<%= pagination.current + 1 %>">Next</a><% } %>
                    </nav>
                <% } %>
            </div>
        </main>
        <%- include('./partials/footer'); %>
        <%- include('./partials/scripts/bootstrap'); %>
    </body>
</html>

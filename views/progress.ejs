<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Labeler - PR progress</title>
        <%- include('./partials/head/meta'); %>
        <%- include('./partials/head/link'); %>
        <%- include('./partials/head/noscript'); %>
    </head>
    <body class="min-vh-100 mw-100 d-flex flex-column justify-content-between">
        <%- include('./partials/header'); %>
        <main>
            <div class="container py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                    <div>
                        <span class="pr-section-eyebrow">Study dashboard</span>
                        <h1 class="h2 mb-1">PR classification progress</h1>
                        <p class="text-muted mb-0">Your cards, categories, and discard decisions stay private.</p>
                    </div>
                    <% if (participant) { %>
                        <span class="badge rounded-pill text-bg-primary"><i class="bi bi-person me-1" aria-hidden="true"></i><%= participant.name %></span>
                    <% } %>
                </div>

                <% if (selectedProgress) { %>
                    <section class="pr-progress-highlight mb-4" aria-labelledby="selected-progress-title">
                        <div class="d-flex justify-content-between align-items-center gap-3">
                            <div>
                                <span class="pr-section-eyebrow">Private participant progress</span>
                                <h2 class="h4 mb-0" id="selected-progress-title"><%= participant.name %></h2>
                            </div>
                            <strong class="display-6"><%= selectedProgress.percentage %>%</strong>
                        </div>
                        <div class="progress mt-3" role="progressbar" aria-valuenow="<%= selectedProgress.percentage %>" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width: <%= selectedProgress.percentage %>%"></div>
                        </div>
                        <div class="row row-cols-1 row-cols-md-3 g-3 mt-2" aria-label="Private progress breakdown">
                            <div class="col">
                                <div class="pr-progress-card h-100">
                                    <span class="pr-meta-label">Classified</span>
                                    <strong class="d-block fs-4 text-success"><%= selectedProgress.classified %></strong>
                                </div>
                            </div>
                            <div class="col">
                                <div class="pr-progress-card h-100">
                                    <span class="pr-meta-label">Discarded</span>
                                    <strong class="d-block fs-4 text-secondary"><%= selectedProgress.discarded %></strong>
                                </div>
                            </div>
                            <div class="col">
                                <div class="pr-progress-card h-100">
                                    <span class="pr-meta-label">Pending</span>
                                    <strong class="d-block fs-4 text-warning"><%= selectedProgress.pending %></strong>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 text-muted small mt-3">
                            <span><%= selectedProgress.completed %> of <%= selectedProgress.total %> cards completed</span>
                            <a class="btn btn-sm btn-outline-primary" href="/<%= encodeURIComponent(participant.name) %>/queue">Open my queue</a>
                        </div>
                    </section>
                <% } else { %>
                    <div class="alert alert-info" role="status">
                        <i class="bi bi-person-check me-1" aria-hidden="true"></i>
                        Select a participant to view private study progress.
                        <a class="alert-link" href="/login">Choose participant</a>
                    </div>
                <% } %>
            </div>
        </main>
        <%- include('./partials/footer'); %>
        <%- include('./partials/scripts/bootstrap'); %>
    </body>
</html>

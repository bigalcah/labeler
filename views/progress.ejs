<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Labeler - PR progress</title>
        <%- include('./partials/head/meta'); %>
        <%- include('./partials/head/link'); %>
        <%- include('./partials/head/noscript'); %>
    </head>
    <body class="min-vh-100 mw-100 d-flex flex-column justify-content-between">
        <%- include('./partials/header'); %>
        <main>
            <div class="container py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                    <div>
                        <span class="pr-section-eyebrow">Study dashboard</span>
                        <h1 class="h2 mb-1">PR classification progress</h1>
                        <p class="text-muted mb-0">Each participant receives the same 300 cards independently.</p>
                    </div>
                    <% if (participant) { %>
                        <span class="badge rounded-pill text-bg-primary"><i class="bi bi-person me-1" aria-hidden="true"></i><%= participant.name %></span>
                    <% } %>
                </div>

                <% if (selectedProgress) { %>
                    <section class="pr-progress-highlight mb-4" aria-labelledby="selected-progress-title">
                        <div class="d-flex justify-content-between align-items-center gap-3">
                            <div>
                                <span class="pr-section-eyebrow">Selected participant</span>
                                <h2 class="h4 mb-0" id="selected-progress-title"><%= selectedProgress.name %></h2>
                            </div>
                            <strong class="display-6"><%= selectedProgress.percentage || 0 %>%</strong>
                        </div>
                        <div class="progress mt-3" role="progressbar" aria-valuenow="<%= selectedProgress.percentage || 0 %>" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width: <%= selectedProgress.percentage || 0 %>%"></div>
                        </div>
                        <div class="d-flex justify-content-between text-muted small mt-2">
                            <span><%= selectedProgress.completed %> completed</span>
                            <span><%= selectedProgress.pending %> pending</span>
                        </div>
                    </section>
                <% } %>

                <section aria-labelledby="participants-progress-title">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h4 mb-0" id="participants-progress-title">Participants</h2>
                        <span class="text-muted small"><%= reviewers.length %> participants</span>
                    </div>
                    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                        <% reviewers.forEach(reviewer => { %>
                            <div class="col">
                                <article class="pr-progress-card h-100">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div>
                                            <span class="pr-meta-label"><i class="bi bi-person me-1" aria-hidden="true"></i>Participant</span>
                                            <h3 class="h5 mb-0 mt-1"><%= reviewer.name %></h3>
                                        </div>
                                        <strong class="text-primary"><%= reviewer.percentage || 0 %>%</strong>
                                    </div>
                                    <div class="progress mt-3" role="progressbar" aria-valuenow="<%= reviewer.percentage || 0 %>" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" style="width: <%= reviewer.percentage || 0 %>%"></div>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted small mt-2">
                                        <span><%= reviewer.completed %> completed</span>
                                        <span><%= reviewer.pending %> pending</span>
                                    </div>
                                    <a class="btn btn-sm btn-outline-primary mt-3" href="/instances?participant=<%= encodeURIComponent(reviewer.name) %>">View cards</a>
                                </article>
                            </div>
                        <% }); %>
                    </div>
                </section>
            </div>
        </main>
        <%- include('./partials/footer'); %>
        <%- include('./partials/scripts/bootstrap'); %>
    </body>
</html>

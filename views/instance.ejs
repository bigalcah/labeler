<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Labeler - PR card</title>
        <%- include('./partials/head/meta'); %>
        <%- include('./partials/head/link'); %>
        <%- include('./partials/head/noscript'); %>
    </head>
    <body class="min-vh-100 mw-100 d-flex flex-column justify-content-between">
        <%- include('./partials/header'); %>
        <main>
            <div class="container py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                    <div>
                        <span class="pr-section-eyebrow">Card detail</span>
                        <h1 class="h3 mb-0">Pull request card</h1>
                    </div>
                    <a class="btn btn-outline-secondary" href="/instances<%= participant ? `?participant=${encodeURIComponent(participant.name)}` : "" %>">
                        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to PR cards
                    </a>
                </div>
                <%- include('./partials/instance/data', { data: instance }); %>
                <% if (participant) { %>
                    <div class="alert alert-info mt-3" role="status">
                        <i class="bi bi-person-check me-1" aria-hidden="true"></i>
                        This card is being viewed in <strong><%= participant.name %></strong>'s private study context. Classification remains in the PR queue.
                    </div>
                <% } %>
            </div>
        </main>
        <%- include('./partials/footer'); %>
        <%- include('./partials/scripts/bootstrap'); %>
    </body>
</html>

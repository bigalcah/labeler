<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Labeler - PR card</title>
        <%- include('./partials/head/meta'); %>
        <%- include('./partials/head/link'); %>
        <%- include('./partials/head/noscript'); %>
    </head>
    <body class="min-vh-100 mw-100 d-flex flex-column justify-content-between">
        <%- include('./partials/header'); %>
        <main>
            <div class="container py-3">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                    <div>
                        <span class="pr-section-eyebrow">Card detail</span>
                        <h1 class="h3 mb-0">Pull request card</h1>
                    </div>
                    <a class="btn btn-outline-secondary" href="/<%= encodeURIComponent(participant.name) %>/queue/<%= encodeURIComponent(instance.id) %>">
                        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to private card
                    </a>
                </div>
                <%- include('./partials/instance/data', { data: instance }); %>
                <% if (participant) { %>
                    <div class="alert <%= instance.status === "CLASSIFIED" ? "alert-success" : instance.status === "DISCARDED" ? "alert-secondary" : "alert-warning" %> mt-3" role="status">
                         <i class="bi bi-person-check me-1" aria-hidden="true"></i>
                         <strong><%= instance.status %></strong> in <strong><%= participant.name %></strong>'s private study context.
                         <% if (instance.own_category) { %> Category: <strong><%= instance.own_category %></strong>.<% } %>
                         <% if (instance.discard_reason) { %> Reason: <strong><%= instance.discard_reason %></strong>.<% } %>
                    </div>
                <% } %>
            </div>
        </main>
        <%- include('./partials/footer'); %>
        <%- include('./partials/scripts/bootstrap'); %>
    </body>
</html>

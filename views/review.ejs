<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Labeler - PR classification</title>
        <%- include('./partials/head/meta'); %>
        <%- include('./partials/head/link'); %>
        <%- include('./partials/head/noscript'); %>
    </head>
    <body class="min-vh-100 mw-100 d-flex flex-column justify-content-between">
        <%- include('./partials/header'); %>
        <main>
            <div class="container">
                <% if (participant && card) { %>
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                        <div>
                            <span class="pr-section-eyebrow">Private study card</span>
                            <h1 class="h3 mb-0">PR classification</h1>
                        </div>
                        <div class="text-muted small text-md-end">
                            <div><%= progress.completed %>/<%= total %> completed by <%= participant.name %></div>
                            <div><%= progress.pending %> pending · <%= progress.classified %> classified · <%= progress.discarded %> discarded</div>
                        </div>
                    </div>

                    <nav class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3" aria-label="Card navigation">
                        <% if (navigation?.previousId) { %>
                            <a class="btn btn-outline-secondary" href="/queue/<%= encodeURIComponent(navigation.previousId) %>">
                                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Previous
                            </a>
                        <% } else { %>
                            <span class="btn btn-outline-secondary disabled" aria-disabled="true">
                                <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Previous
                            </span>
                        <% } %>
                        <span class="badge rounded-pill text-bg-light border">Card <%= card.ordinal + 1 %> of <%= total %></span>
                        <% if (navigation?.nextId) { %>
                            <a class="btn btn-outline-secondary" href="/queue/<%= encodeURIComponent(navigation.nextId) %>">
                                Next<i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                            </a>
                        <% } else { %>
                            <span class="btn btn-outline-secondary disabled" aria-disabled="true">
                                Next<i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                            </span>
                        <% } %>
                    </nav>

                    <div class="alert <%= card.status === "CLASSIFIED" ? "alert-success" : card.status === "DISCARDED" ? "alert-secondary" : "alert-warning" %>" role="status">
                        <% if (card.status === "CLASSIFIED") { %>
                            <i class="bi bi-check-circle me-1" aria-hidden="true"></i>
                            Classified privately as <strong><%= card.own_category || "a personal category" %></strong>. You can edit this response below.
                        <% } else if (card.status === "DISCARDED") { %>
                            <i class="bi bi-slash-circle me-1" aria-hidden="true"></i>
                            Discarded privately for <strong><%= card.discard_reason || "no reason supplied" %></strong>. Other participants can still review this card.
                        <% } else { %>
                            <i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>
                            This card is pending your private response.
                        <% } %>
                    </div>

                    <%- include('./partials/instance/data', { data: card }); %>

                    <% if (card.status !== "DISCARDED") { %>
                        <section class="card mt-3" aria-labelledby="classification-title">
                            <div class="card-body">
                                <h2 class="h5" id="classification-title">Main cause of rework or extra effort</h2>
                                <form action="/queue/<%= encodeURIComponent(card.id) %>/classify"
                                      method="post">
                                    <input type="hidden" name="csrf_token" value="<%= locals.csrfToken %>">
                                    <input type="hidden" name="expected_revision" value="<%= card.revision || 0 %>">
                                    <fieldset class="mb-3">
                                        <legend class="form-label fs-6">Personal category</legend>
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                            <p class="text-muted small mb-0">Choose the category that best describes the main cause. Edit a category without changing your current selection.</p>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal"
                                                    data-bs-target="#new-category-modal">
                                                New category
                                            </button>
                                        </div>
                                        <% if (categories.length > 0 && !card.category_id) { %>
                                            <p class="text-muted small mb-2">A category is required to save this classification.</p>
                                        <% } %>
                                        <ul class="list-unstyled category-selection-list mb-0" id="category-list" data-category-list>
                                            <%
                                                const selectedCategoryIndex = categories.findIndex(category => category.id === card.category_id);
                                                const orderedCategories = selectedCategoryIndex > 0
                                                    ? [categories[selectedCategoryIndex], ...categories.slice(0, selectedCategoryIndex), ...categories.slice(selectedCategoryIndex + 1)]
                                                    : categories;
                                            %>
                                            <% orderedCategories.forEach(category => { %>
                                                <li class="category-option category-slot-<%= category.color_slot %><%= category.id === card.category_id ? " is-selected" : "" %>" data-category-option="<%= category.id %>">
                                                    <label class="category-option-label">
                                                        <input type="radio" name="category_id" value="<%= category.id %>"
                                                               class="form-check-input category-radio" data-category-radio
                                                               data-category-updated-at="<%= category.updated_at ? new Date(category.updated_at).toISOString() : "" %>"
                                                               <%= category.id === card.category_id ? "checked" : "" %> <%= card.category_id ? "" : "required" %>>
                                                        <span class="category-option-text">
                                                            <span class="category-name" data-category-label="<%= category.id %>"><%= category.raw_name %></span>
                                                            <% if (category.definition) { %>
                                                                <span class="category-definition"><%= category.definition %></span>
                                                            <% } %>
                                                        </span>
                                                        <span class="category-selected-indicator" aria-hidden="true"><i class="bi bi-check-lg"></i>Selected</span>
                                                    </label>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary category-edit-button" data-category-rename
                                                            data-category-id="<%= category.id %>"
                                                            data-category-version="<%= category.updated_at ? new Date(category.updated_at).toISOString() : "" %>"
                                                            data-category-name="<%= category.raw_name %>"
                                                            data-category-definition="<%= category.definition || "" %>"
                                                            data-bs-toggle="modal" data-bs-target="#rename-category-modal">
                                                        Edit <span class="visually-hidden"><%= category.raw_name %></span>
                                                    </button>
                                                </li>
                                            <% }); %>
                                            <% if (categories.length === 0) { %>
                                                <li class="category-empty text-muted small" data-category-empty="true">You have not created any personal categories yet. Use <strong>New category</strong> above to create one, then select it.</li>
                                            <% } %>
                                        </ul>
                                    </fieldset>
                                    <label class="form-label" for="remarks">Observation (optional)</label>
                                    <textarea id="remarks" name="remarks" class="form-control mb-3" rows="4"
                                              placeholder="Why does this category describe the main cause?"><%= card.remarks || "" %></textarea>
                                    <button class="btn btn-primary" type="submit">
                                        <%= card.status === "CLASSIFIED" ? "Update classification and continue" : "Save classification and continue" %>
                                    </button>
                                </form>
                            </div>
                        </section>

                        <% if (card.status === "PENDING") { %>
                            <section class="card border-secondary mt-3" aria-labelledby="discard-title">
                                <div class="card-body">
                                    <h2 class="h5" id="discard-title">Cannot classify this card?</h2>
                                    <p class="text-muted">Discarding is private to <%= participant.name %> and does not remove the card for other participants.</p>
                                     <form action="/queue/<%= encodeURIComponent(card.id) %>/discard"
                                           method="post" data-confirm-discard="Discard this card for your participant?">
                                         <input type="hidden" name="csrf_token" value="<%= locals.csrfToken %>">
                                         <input type="hidden" name="expected_revision" value="<%= card.revision || 0 %>">
                                        <label class="form-label" for="discard-reason">Reason (optional)</label>
                                        <textarea id="discard-reason" name="reason" class="form-control mb-3" rows="2"
                                                  placeholder="Optional private reason"></textarea>
                                        <button class="btn btn-outline-secondary" type="submit">
                                            <i class="bi bi-slash-circle me-1" aria-hidden="true"></i>Discard and continue
                                        </button>
                                    </form>
                                </div>
                            </section>
                        <% } %>
                    <% } %>

                    <% if (card.status !== "DISCARDED") { %>
                        <div class="modal fade" id="new-category-modal" tabindex="-1" aria-labelledby="new-category-title">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h2 class="modal-title h5" id="new-category-title">New personal category</h2>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                     <form id="new-category-form" data-category-action="/categories">
                                         <input type="hidden" name="csrf_token" value="<%= locals.csrfToken %>">
                                        <div class="modal-body">
                                            <label class="form-label" for="category-name">Name</label>
                                            <input id="category-name" name="name" class="form-control" required maxlength="160">
                                            <label class="form-label mt-3" for="category-definition">Definition (optional)</label>
                                            <textarea id="category-definition" name="definition" class="form-control" rows="3" maxlength="500"
                                                      aria-describedby="category-definition-hint"></textarea>
                                            <div id="category-definition-hint" class="form-text">Up to 500 characters. Shown with the category name while you classify.</div>
                                            <div id="category-error" class="text-danger mt-2 d-none" role="alert">
                                                This category already exists or could not be created.
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary">Create category</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="modal fade" id="rename-category-modal" tabindex="-1" aria-labelledby="rename-category-title">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h2 class="modal-title h5" id="rename-category-title">Rename personal category</h2>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <form id="rename-category-form" data-category-action="/categories">
                                        <input type="hidden" name="csrf_token" value="<%= locals.csrfToken %>">
                                        <input type="hidden" name="category_id">
                                        <input type="hidden" name="expected_updated_at">
                                        <div class="modal-body">
                                            <label class="form-label" for="rename-category-name">Name</label>
                                            <input id="rename-category-name" name="name" class="form-control" required maxlength="160"
                                                   aria-describedby="rename-category-error">
                                            <label class="form-label mt-3" for="rename-category-definition">Definition (optional)</label>
                                            <textarea id="rename-category-definition" name="definition" class="form-control" rows="3" maxlength="500"
                                                      aria-describedby="rename-category-definition-hint"></textarea>
                                            <div id="rename-category-definition-hint" class="form-text">Up to 500 characters. Shown with the category name while you classify.</div>
                                            <div id="rename-category-error" class="text-danger mt-2 d-none" role="alert">
                                                This category name is already in use or could not be saved.
                                            </div>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary">Save category</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% } %>
                <% } else if (participant) { %>
                    <h1 class="text-center mb-3">Classification queue complete</h1>
                    <p class="text-center">You classified or discarded every card in your private queue.</p>
                    <div class="text-center"><a class="btn btn-outline-primary" href="/progress">View private progress</a></div>
                <% } else { %>
                    <h1 class="text-center mb-3">Select a participant from the login page</h1>
                    <%- include('./partials/home-button'); %>
                <% } %>
            </div>
        </main>
        <%- include('./partials/footer'); %>
        <%- include('./partials/scripts/bootstrap'); %>
        <script src="/js/review.js"></script>
        <script src="/js/pr-card.js"></script>
    </body>
</html>

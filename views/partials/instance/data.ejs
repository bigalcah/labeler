<% if (data && data.source_type && data.title) { %>
    <article class="card shadow-sm" aria-labelledby="pr-card-title">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                    <p class="text-muted mb-1">
                        <%= data.repository || "Repository unavailable" %> #<%= data.pr_number || "?" %>
                    </p>
                    <h2 class="card-title h3" id="pr-card-title"><%= data.title %></h2>
                </div>
                <% if (data.html_url) { %>
                    <a class="btn btn-outline-secondary" href="<%= data.html_url %>" target="_blank"
                       rel="noopener noreferrer">Reference on GitHub</a>
                <% } %>
            </div>
            <dl class="row mb-3">
                <dt class="col-sm-3">Language (CSV)</dt>
                <dd class="col-sm-9"><%= data.language || "Not available" %></dd>
                <dt class="col-sm-3">State</dt>
                <dd class="col-sm-9"><%= data.state || "Not available" %></dd>
                <dt class="col-sm-3">Author</dt>
                <dd class="col-sm-9"><%= data.author || "Not available" %></dd>
                <dt class="col-sm-3">Dates</dt>
                <dd class="col-sm-9">
                    Created: <%= data.dates?.created_at || "—" %> ·
                    Merged: <%= data.dates?.merged_at || "—" %>
                </dd>
            </dl>
            <% if (data.body) { %>
                <h3 class="h5">Description</h3>
                <pre class="border rounded p-3 text-wrap"><%= data.body %></pre>
            <% } %>
            <% if (data.summary) { %>
                <h3 class="h5">Available metrics</h3>
                <div class="row row-cols-2 row-cols-md-4 g-2 mb-3">
                    <% Object.entries(data.summary).forEach(([name, value]) => { %>
                        <% if (value !== null && value !== undefined && value !== "") { %>
                            <div class="col"><div class="border rounded p-2"><small class="text-muted d-block"><%= name %></small><%= value %></div></div>
                        <% } %>
                    <% }); %>
                </div>
            <% } %>
            <% if (data.evidence?.selected || data.evidence?.all_text) { %>
                <details>
                    <summary>Evidence available in CSV</summary>
                    <div class="mt-3">
                        <pre class="border rounded p-3 text-wrap"><%= data.evidence.selected || data.evidence.all_text %></pre>
                    </div>
                </details>
            <% } %>
            <details class="mt-3">
                <summary>Original JSON data</summary>
                <pre class="border rounded p-3 mt-2 overflow-auto"><code><%= JSON.stringify(data.raw_payload, null, 2) %></code></pre>
            </details>
        </div>
    </article>
<% } else { %>
    <pre class="border rounded"><code class="language-json" style="white-space: pre!important; height: 550px!important;"><%= JSON.stringify(data, null, 2) || " " %></code></pre>
<% } %>

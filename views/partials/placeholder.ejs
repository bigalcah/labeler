<svg role="img"
     width="100%"
     height="100%"
     focusable="false"
     xmlns="http://www.w3.org/2000/svg"
     preserveAspectRatio="xMidYMid slice"
     aria-label="Placeholder Image"
     font-size="1.125rem"
     text-anchor="middle"
     class="<%- locals.class || "" %>"
     user-select="none"
>
    <title><%- locals.title || "Placeholder Title" %></title>
    <rect width="100%" height="100%" fill="#868e96"></rect>
    <text x="50%" y="50%" fill="#dedede" dy=".3em" font-size="1.25em"><%- locals.text || "Placeholder Text" %></text>
</svg>

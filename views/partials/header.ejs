<header class="mb-3">
    <nav class="navbar navbar-expand-lg bg-light">
        <div class="container-fluid">
            <a href="https://seart.si.usi.ch" target="_blank" class="navbar-brand logo">
                <span class="logo-box">SE</span><span class="logo-text">ART</span>
            </a>
            <button type="button"
                    class="navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbar"
                    aria-controls="navbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon"></span>
            </button>
            <div id="navbar" class="collapse navbar-collapse">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <%
                        const links = [
                            [ "/queue", "PR cards", locals.path === "/queue" ],
                            [ "/progress", "Progress", locals.path === "/progress" ],
                        ];
                        links.forEach(([ link, name, active ]) => {
                            const classes = active ? "nav-link active" : "nav-link";
                    %>
                        <li class="nav-item">
                            <a class="<%- classes %>" href="<%- link %>"><%- name %></a>
                        </li>
                    <%
                        });
                    %>
                </ul>
                <% if (!!locals.participant) { %>
                    <div class="py-2 ms-lg-auto">
                        <i class="bi bi-person-fill"></i>
                        <span><%- locals.participant.name %></span>
                    </div>
                <% } %>
                <% if (locals.sessionContext && locals.csrfToken) { %>
                    <form class="ms-lg-3 py-2" action="/logout" method="post">
                        <input type="hidden" name="csrf_token" value="<%= locals.csrfToken %>">
                        <button class="btn btn-outline-secondary" type="submit">Log out</button>
                    </form>
                <% } %>
            </div>
        </div>
    </nav>
</header>

<header class="mb-3">
    <nav class="navbar navbar-expand-lg bg-light">
        <div class="container-fluid">
            <a href="https://seart.si.usi.ch" target="_blank" class="navbar-brand logo">
                <span class="logo-box">SE</span><span class="logo-text">ART</span>
            </a>
            <button type="button"
                    class="navbar-toggler"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbar"
                    aria-controls="navbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon"></span>
            </button>
            <div id="navbar" class="collapse navbar-collapse">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <%
                        const participantQuery = locals.participant?.name
                            ? `?participant=${encodeURIComponent(locals.participant.name)}`
                            : "";
                        const links = [
                            [ "/instances", "PR cards" ],
                            [ "/conflicts", "Pending cards" ],
                            [ "/progress", "Progress" ],
                            [ "/export", "Export" ],
                        ];
                        links.forEach(([ link, name ]) => {
                            const classes = link === locals.path ? "nav-link active" : "nav-link";
                    %>
                        <li class="nav-item">
                            <a class="<%- classes %>" href="<%- link %><%- [ "/instances", "/conflicts", "/progress" ].includes(link) ? participantQuery : "" %>"><%- name %></a>
                        </li>
                    <%
                        });
                    %>
                </ul>
                <% if (!!locals.participant) { %>
                    <div class="py-2 ms-lg-auto">
                        <i class="bi bi-person-fill"></i>
                        <span><%- locals.participant.name %></span>
                    </div>
                <% } %>
            </div>
        </div>
    </nav>
</header>

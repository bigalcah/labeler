{
  "name": "labeler",
  "version": "1.0.0",
  "private": true,
  "description": "Quickly set up and perform collaborative manual analysis.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "quality": "node scripts/run-quality-gates.js quality",
    "lint": "node scripts/run-quality-gates.js lint",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"public/css/**/*.css\"",
    "lint:md": "markdownlint *.md",
    "minify": "npm-run-all --parallel minify:*",
    "minify:css": "cleancss --batch --batch-suffix '' public/css/*.css",
    "backup:legacy": "node scripts/backup-legacy-labeler.js",
    "bootstrap:study": "node scripts/bootstrap-study.js",
    "credentials:generate": "node scripts/generate-credential-manifest.js",
    "credentials:reset": "node scripts/reset-participant-credential.js",
    "enrich:study": "node scripts/enrich-study.js",
    "verify:github-coverage": "node scripts/verify-github-coverage.js",
    "import:csv": "node scripts/import-pr-csv.js",
    "migrate:study": "node scripts/migrate-study-schema.js",
    "retire:legacy:apply": "node scripts/retire-legacy-labeler.js --apply",
    "retire:legacy:clean-check": "node scripts/retire-legacy-labeler.js --assert-clean",
    "retire:legacy:check": "node scripts/retire-legacy-labeler.js --verify-only",
    "test:foundation": "node --test test/foundation.test.js",
    "test:unit": "node scripts/run-quality-gates.js unit",
    "test:integration": "node scripts/run-quality-gates.js integration",
    "test:e2e": "node scripts/run-quality-gates.js e2e",
    "test:migrations": "node --test test/verification-contracts.test.js test/study-category-migration-contract.test.js test/schema-retirement.test.js test/legacy-retirement-guard.test.js",
    "test:study-http": "node scripts/run-quality-gates.js integration",
    "test:study-concurrency": "node scripts/run-quality-gates.js integration",
    "test:rollback-readonly": "node --test test/verification-contracts.test.js",
    "start": "NODE_ENV=production node index.js",
    "dev": "nodemon index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seart-group/labeler.git"
  },
  "author": {
    "name": "Ozren Dabić",
    "email": "dabico@usi.ch",
    "url": "https://dabico.github.io/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/seart-group/labeler/issues"
  },
  "homepage": "https://github.com/seart-group/labeler#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "clean-css-cli": "^5.6.3",
    "eslint": "^9.39.2",
    "globals": "^16.5.0",
    "markdownlint": "^0.40.0",
    "markdownlint-cli": "^0.47.0",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1"
  },
  "dependencies": {
    "body-parser": "^2.2.1",
    "argon2": "^0.45.1",
    "compression": "^1.8.1",
    "csv-parse": "^6.2.1",
    "dotenv": "^16.6.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-actuator": "^1.8.4",
    "express-file-routing": "^3.1.0",
    "express-minify-html-2": "^2.0.0",
    "express-paginate": "^1.0.2",
    "JSONStream": "^1.3.5",
    "marked": "^18.0.10",
    "morgan": "^1.10.1",
    "neoip": "^3.0.1",
    "pg": "^8.16.3",
    "pg-error-enum": "^1.0.2",
    "pg-query-stream": "^4.10.3",
    "postgres-array": "^3.0.4",
    "rotating-file-stream": "^3.2.7",
    "sanitize-html": "^2.17.7",
    "uglify-js": "^3.19.3",
    "useragent": "^2.3.0"
  }
}

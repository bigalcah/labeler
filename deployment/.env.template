COMPOSE_PROJECT_NAME=labeling

DATABASE_NAME=$DATABASE_NAME
DATABASE_USER=$DATABASE_USER
DATABASE_PORT=5432
PUBLIC_HOSTNAME=$PUBLIC_HOSTNAME
APP_ORIGIN=https://$PUBLIC_HOSTNAME

# Every path below is absolute, external to this repository, and names a protected secret file.
DATABASE_PASSWORD_HOST_PATH=/absolute/external/database-password
DATABASE_PASSWORD_DATABASE_HOST_PATH=/absolute/external/database-password-postgres
SESSION_SECRET_CURRENT_HOST_PATH=/absolute/external/session-current
SESSION_SECRET_PREVIOUS_HOST_PATH=/absolute/external/session-previous
STUDY_ACCOUNT_MANIFEST_HOST_PATH=/absolute/external/study-account-manifest.json
PGPASSFILE_HOST_PATH=/absolute/external/legacy-retirement.pgpass

# Clean-overlay-only inputs consumed only by labeling-study-prepare. Do not set or require
# them for the mutually exclusive docker-compose.existing.yml retirement overlay.
STUDY_VALIDATION_ACCOUNT_MANIFEST_HOST_PATH=/absolute/external/validation-study-account-manifest.json
STUDY_PROFILES_INPUT_HOST_PATH=/absolute/external/study-profiles.json
STUDY_CURRENT_CONFIG_HOST_PATH=/absolute/external/current-study.json
STUDY_VALIDATION_CONFIG_HOST_PATH=/absolute/external/validation-study.json

# GitHub enrichment is disabled by the base deployment. See GITHUB-ENRICHMENT.md
# to opt in with its dedicated Compose override and an external token file path.

# Host-run encrypted study backups are not mounted into the public stack. See ROLLBACK.md.
# STUDY_BACKUP_ARCHIVE=/absolute/external/backups/study-<timestamp>.dump.enc
# STUDY_BACKUP_MANIFEST=/absolute/external/backups/study-<timestamp>.manifest.json
# STUDY_BACKUP_ENCRYPTION_KEY_FILE=/absolute/external/backup-encryption-key
# STUDY_BACKUP_RETENTION_DAYS=30

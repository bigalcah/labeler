COMPOSE_PROJECT_NAME=labeling

DATABASE_NAME=$DATABASE_NAME
DATABASE_USER=$DATABASE_USER
DATABASE_PASS=$DATABASE_PASS
DATABASE_PORT=5432

# GitHub enrichment is opt-in. These variables are consumed only by labeling-study-prepare.
GITHUB_ENRICHMENT_ENABLED=true
GITHUB_API_BASE=https://api.github.com
GITHUB_CREDENTIAL_ALIASES={"owner/repository":{"tokenEnv":"GITHUB_TOKEN","permissions":["metadata","pulls","contents","issues"]}}
GITHUB_DEFAULT_ALIAS=owner/repository
# Set only when GITHUB_ENRICHMENT_ENABLED=true.
GITHUB_TOKEN=<read-only-token-from-secret-store>
